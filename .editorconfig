# Baseline for editors and agents. The project's formatter wins where they differ.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs,cs}]
indent_size = 4

[{Makefile,*.mk,*.go,go.mod}]
indent_style = tab

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
